# Vertrag für scripts/env-check.sh (#797). SmartTasks hat auf labs KEINE .env:
# die Werte stehen als Environment= in der systemd-Unit smarttasks.service.
# deploy.sh und claude-deploy (labs) vergleichen vor dem Build die Key-NAMEN
# dieser Datei mit `systemctl show smarttasks.service -p Environment` und
# brechen ab, wenn einer fehlt. Keys mit Default bekommen `# optional` DIREKT
# darüber. Neuer Key → hier eintragen UND in der Unit setzen (Admin:
# systemctl edit smarttasks, dann systemctl daemon-reload).
# Die Werte unten sind Platzhalter für die lokale Entwicklung.

NODE_ENV=development
# Port des adapter-node-Servers (Caddy proxied dorthin)
PORT=3020
# SQLite-Datei (src/lib/server/db)
DATABASE_PATH=./data/smarttasks.db
# Öffentliche URL (adapter-node, CSRF-Origin-Check)
ORIGIN=https://tasks.remoterepublic.com
# Max. Request-Body (adapter-node, Datei-Uploads; README: 6M passend zum 5-MB-Limit)
BODY_SIZE_LIMIT=6M
